rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth()              { return request.auth != null; }
    function isOwner(uid)          { return request.auth.uid == uid; }
    function userRole()            { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role; }
    function isEmpresa()           { return isAuth() && userRole() == "empresa"; }
    function isCandidato()         { return isAuth() && userRole() == "candidato"; }

    // ── usuarios ─────────────────────────────────────────────────────────────
    // Cada usuario lee y escribe solo su propio documento.
    match /usuarios/{uid} {
      allow read, write: if isAuth() && isOwner(uid);
    }

    // ── empresas ─────────────────────────────────────────────────────────────
    // Cualquier usuario autenticado puede leer perfiles de empresa (para candidatos).
    // Solo el dueño puede escribir su propio perfil.
    match /empresas/{uid} {
      allow read: if isAuth();
      allow write: if isAuth() && isOwner(uid);
    }

    // ── candidatos ───────────────────────────────────────────────────────────
    // El candidato escribe su propio perfil.
    // Las empresas pueden leer perfiles de candidatos (para el módulo de matches).
    match /candidatos/{uid} {
      allow read: if isAuth() && (isOwner(uid) || isEmpresa());
      allow write: if isAuth() && isOwner(uid);
    }

    // ── vacantes ─────────────────────────────────────────────────────────────
    // Cualquier usuario autenticado puede leer vacantes activas.
    // Solo la empresa dueña puede crear/editar/eliminar.
    match /vacantes/{vacanteId} {
      allow read: if isAuth();
      allow create: if isEmpresa() && request.resource.data.empresaId == request.auth.uid;
      allow update: if isEmpresa() && resource.data.empresaId == request.auth.uid;
      allow delete: if isEmpresa() && resource.data.empresaId == request.auth.uid;
    }

    // ── postulaciones ─────────────────────────────────────────────────────────
    // El candidato crea su postulación; candidato y empresa dueña pueden leerla.
    // La empresa puede actualizar el estado (pipeline).
    match /postulaciones/{postId} {
      allow read:   if isAuth() && (
                      resource.data.candidatoId == request.auth.uid ||
                      resource.data.empresaId   == request.auth.uid
                    );
      allow create: if isCandidato() && request.resource.data.candidatoId == request.auth.uid;
      allow update: if isAuth() && (
                      // Empresa actualiza estado / nota interna
                      (isEmpresa() && resource.data.empresaId == request.auth.uid) ||
                      // Candidato puede retirar su postulación
                      (isCandidato() && resource.data.candidatoId == request.auth.uid)
                    );
      allow delete: if isCandidato() && resource.data.candidatoId == request.auth.uid;
    }

    // ── matches ───────────────────────────────────────────────────────────────
    // Las empresas ven sus propios matches. Los candidatos ven matches donde aparecen.
    // La escritura queda reservada al backend (Cloud Functions / Admin SDK).
    match /matches/{matchId} {
      allow read: if isAuth() && (
                    resource.data.empresaId   == request.auth.uid ||
                    resource.data.candidatoId == request.auth.uid
                  );
      // Temp: permitir create/update autenticado mientras no hay Cloud Functions
      allow create, update: if isEmpresa() && request.resource.data.empresaId == request.auth.uid;
    }

    // ── conversaciones ────────────────────────────────────────────────────────
    // Solo los participantes pueden leer/escribir.
    match /conversaciones/{convId} {
      allow read, write: if isAuth() && request.auth.uid in resource.data.participantes;
      allow create:      if isAuth() && request.auth.uid in request.resource.data.participantes;

      // mensajes (subcolección)
      match /mensajes/{msgId} {
        allow read:   if isAuth() &&
                        request.auth.uid in get(/databases/$(database)/documents/conversaciones/$(convId)).data.participantes;
        allow create: if isAuth() &&
                        request.auth.uid in get(/databases/$(database)/documents/conversaciones/$(convId)).data.participantes &&
                        request.resource.data.senderId == request.auth.uid;
      }
    }

  }
}
